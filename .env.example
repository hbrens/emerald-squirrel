# 复制为 .env 并按需修改(.env 不入库)
# LLM 网关(OpenAI 兼容 /chat/completions)。以下三项是「设置页未添加任何模型时」的兜底配置;
# 页面添加模型后以页面配置为准(存 DB,见 design/09 Models)
LLM_BASE_URL=http://localhost:29005/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.6-sol
# 视觉模型:图片/扫描版 PDF 提取用,需支持 image_url 输入
IMAGE_MODEL=gpt-5.6-sol
# Embedding(Ollama)。注意 EMBEDDING_DIM 必须与 schema 的 FLOAT[N] 一致,换模型需全量重建向量
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
# 服务端口(唯一来源:compose 端口映射 / vite 代理 / e2e 默认地址都读这里)
PORT=61127
# DATA_DIR=apps/server/data
