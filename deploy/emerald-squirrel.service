# ~/.config/systemd/user/emerald-squirrel.service
[Unit]
Description=emerald-squirrel chat knowledge base
After=network.target

[Service]
ExecStart=/usr/bin/node --env-file=/path/to/htwm-app/.env /path/to/htwm-app/apps/server/src/index.ts
Environment=PORT=61127
WorkingDirectory=/path/to/htwm-app/apps/server
Restart=always

[Install]
WantedBy=default.target
